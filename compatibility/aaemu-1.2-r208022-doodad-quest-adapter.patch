+    /// <summary>
+    /// Validates a PlayerBots report request against the authoritative active
+    /// quest, ready endpoint, live world object, and offered selective reward
+    /// before dispatching the normal report event lifecycle.
+    /// </summary>
+    public bool TryReportPlayerBotQuest(
+        Character owner,
+        uint questContextId,
+        uint npcObjId,
+        uint doodadObjId,
+        int selected)
+    {
+        if (owner?.Quests?.ActiveQuests == null || owner.ParentWorld == null ||
+            questContextId == 0 || npcObjId > 0 && doodadObjId > 0 || selected < 0 ||
+            !owner.Quests.ActiveQuests.TryGetValue(questContextId, out var quest) || quest == null ||
+            quest.Status != QuestStatus.Ready && quest.Step != QuestComponentKind.Ready ||
+            !quest.QuestSteps.TryGetValue(QuestComponentKind.Ready, out var readyStep))
+        {
+            return false;
+        }
+
+        var reportActs = readyStep.Components.Values
+            .Where(component => component.IsCurrentlyActive)
+            .SelectMany(component => component.Acts)
+            .Select(act => act.Template)
+            .ToArray();
+
+        var endpointValid = false;
+        if (npcObjId > 0)
+        {
+            var npc = owner.ParentWorld.GetNpc(npcObjId);
+            endpointValid = IsPlayerBotReportObjectInRange(owner, npc) && reportActs
+                .OfType<QuestActConReportNpc>()
+                .Any(act => act.NpcId == npc.TemplateId);
+        }
+        else if (doodadObjId > 0)
+        {
+            var doodad = owner.ParentWorld.GetDoodad(doodadObjId);
+            endpointValid = IsPlayerBotReportObjectInRange(owner, doodad) &&
+                doodad.TryGetPlayerBotCurrentQuest(out var currentQuestId) &&
+                currentQuestId == questContextId && reportActs
+                    .OfType<QuestActConReportDoodad>()
+                    .Any(act => act.DoodadId == doodad.TemplateId);
+        }
+        else
+        {
+            endpointValid = reportActs.OfType<QuestActConReportJournal>().Any();
+        }
+
+        if (!endpointValid)
+            return false;
+
+        if (!quest.QuestSteps.TryGetValue(QuestComponentKind.Reward, out var rewardStep))
+            return false;
+
+        var selectiveIndices = rewardStep.Components.Values
+            .Where(component => component.IsCurrentlyActive)
+            .SelectMany(component => component.Acts)
+            .Select(act => act.Template)
+            .OfType<QuestActSupplySelectiveItem>()
+            .Select(act => act.ThisSelectiveIndex)
+            .Where(index => index >= 0)
+            .Distinct()
+            .ToArray();
+        if (selectiveIndices.Length == 0 ? selected != 0 : !selectiveIndices.Contains(selected))
+            return false;
+
+        DoReportEvents(owner, questContextId, npcObjId, doodadObjId, selected);
+        return true;
+    }
+
+    private static bool IsPlayerBotReportObjectInRange(Character owner, BaseUnit target)
+    {
+        const float maximumInteractionRange = 10f;
+        if (owner?.Transform?.World == null || target?.Transform?.World == null)
+            return false;
+
+        var ownerPosition = owner.Transform.World.Position;
+        var targetPosition = target.Transform.World.Position;
+        if (!float.IsFinite(ownerPosition.X) || !float.IsFinite(ownerPosition.Y) ||
+            !float.IsFinite(ownerPosition.Z) || !float.IsFinite(targetPosition.X) ||
+            !float.IsFinite(targetPosition.Y) || !float.IsFinite(targetPosition.Z))
+            return false;
+
+        return Vector3.DistanceSquared(ownerPosition, targetPosition) <=
+               maximumInteractionRange * maximumInteractionRange;
+    }
