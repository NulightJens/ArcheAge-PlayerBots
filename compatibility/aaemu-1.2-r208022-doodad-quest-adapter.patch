+    /// <summary>
+    /// Resolves one unambiguous quest function from this doodad's current
+    /// phase. This is intentionally read-only and fails closed.
+    /// </summary>
+    public bool TryGetPlayerBotCurrentQuest(out uint questId)
+    {
+        questId = 0;
+        if (Despawn > DateTime.MinValue || CurrentFuncs == null)
+            return false;
+
+        var questIds = CurrentFuncs
+            .Where(func => func != null && func.FuncType == nameof(DoodadFuncQuest))
+            .Select(func => DoodadManager.Instance.GetFuncTemplate(func.FuncId, func.FuncType))
+            .OfType<DoodadFuncQuest>()
+            .Select(func => func.QuestId)
+            .Where(id => id != 0)
+            .Distinct()
+            .Take(2)
+            .ToArray();
+        if (questIds.Length != 1)
+            return false;
+
+        questId = questIds[0];
+        return true;
+    }
