+    /// <summary>
+    /// Bounded, read-only doodad discovery surface for the PlayerBots module.
+    /// </summary>
+    public IReadOnlyList<Doodad> GetPlayerBotDoodadsNear(GameObject observer, float radius)
+    {
+        const float maximumRadius = 100f;
+        const int maximumResults = 256;
+        if (observer?.Transform?.World == null ||
+            !ReferenceEquals(observer.ParentWorld, this) ||
+            !float.IsFinite(radius) || radius <= 0)
+            return [];
+
+        var effectiveRadius = Math.Min(radius, maximumRadius);
+        var origin = observer.Transform.World.Position;
+        if (!float.IsFinite(origin.X) || !float.IsFinite(origin.Y) || !float.IsFinite(origin.Z))
+            return [];
+
+        return WorldManager.GetAround<Doodad>(observer, effectiveRadius)
+            .Where(doodad => doodad?.Transform?.World != null && doodad.Despawn <= DateTime.MinValue)
+            .Select(doodad => (Doodad: doodad, Position: doodad.Transform.World.Position))
+            .Where(candidate =>
+                float.IsFinite(candidate.Position.X) &&
+                float.IsFinite(candidate.Position.Y) &&
+                float.IsFinite(candidate.Position.Z))
+            .OrderBy(candidate => Vector3.DistanceSquared(origin, candidate.Position))
+            .ThenBy(candidate => candidate.Doodad.ObjId)
+            .Take(maximumResults)
+            .Select(candidate => candidate.Doodad)
+            .ToArray();
+    }
+
