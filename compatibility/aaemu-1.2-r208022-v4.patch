+    private static void WaitForSignal(ManualResetEventSlim signal, string description)
+    {
+        if (!signal.Wait(TimeSpan.FromSeconds(10)))
+            throw new TimeoutException($"Timed out waiting for {description}.");
+    }
+
+    private static void WaitForSignal(CountdownEvent signal, string description)
+    {
+        if (!signal.Wait(TimeSpan.FromSeconds(10)))
+            throw new TimeoutException($"Timed out waiting for {description}.");
+    }
+
+    private sealed class RecordingTaskManager : ITaskManager
+    {
+        private readonly Func<bool> _serverStartedLogged;
+        private readonly ConcurrentQueue<string> _events;
+        private readonly ManualResetEventSlim _scheduleEntered;
+        private readonly ManualResetEventSlim _allowSchedule;
+        private readonly bool _scheduleResult;
+        private readonly object _syncRoot = new();
+        private readonly HashSet<AAEmu.Game.Models.Tasks.Task> _activeTasks = [];
+        private int _scheduleCount;
+        private int _scheduleSuccessCount;
+        private int _cancelCount;
+
+        public RecordingTaskManager(
+            Func<bool> serverStartedLogged = null,
+            ConcurrentQueue<string> events = null,
+            ManualResetEventSlim scheduleEntered = null,
+            ManualResetEventSlim allowSchedule = null,
+            bool scheduleResult = true)
+        {
+            _serverStartedLogged = serverStartedLogged;
+            _events = events;
+            _scheduleEntered = scheduleEntered;
+            _allowSchedule = allowSchedule;
+            _scheduleResult = scheduleResult;
+        }
+
+        public List<(AAEmu.Game.Models.Tasks.Task Task, TimeSpan? StartDelay, TimeSpan? RepeatInterval, int Count)> ScheduledTasks { get; } = [];
+        public bool ScheduledAfterServerStarted { get; private set; }
+        public int ScheduleCount => Volatile.Read(ref _scheduleCount);
+        public int ScheduleSuccessCount => Volatile.Read(ref _scheduleSuccessCount);
+        public int CancelCount => Volatile.Read(ref _cancelCount);
+        public int ActiveCount
+        {
+            get
+            {
+                lock (_syncRoot)
+                    return _activeTasks.Count;
+            }
+        }
+
+        public void Initialize() { }
+        public void Start() { }
+        public void Stop() { }
+        public bool Cancel(AAEmu.Game.Models.Tasks.Task task)
+        {
+            Interlocked.Increment(ref _cancelCount);
+            _events?.Enqueue("director-cancel");
+            lock (_syncRoot)
+                return _activeTasks.Remove(task);
+        }
+
+        public bool Schedule(AAEmu.Game.Models.Tasks.Task task, TimeSpan? startTime = null,
+            TimeSpan? repeatInterval = null, int count = -1)
+        {
+            Interlocked.Increment(ref _scheduleCount);
+            ScheduledAfterServerStarted = _serverStartedLogged?.Invoke() ?? false;
+            _scheduleEntered?.Set();
+            if (_allowSchedule != null)
+                WaitForSignal(_allowSchedule, "schedule release");
+
+            if (!_scheduleResult)
+            {
+                _events?.Enqueue("director-schedule-rejected");
+                return false;
+            }
+
+            lock (_syncRoot)
+            {
+                ScheduledTasks.Add((task, startTime, repeatInterval, count));
+                _activeTasks.Add(task);
+            }
+            Interlocked.Increment(ref _scheduleSuccessCount);
+            _events?.Enqueue("director-schedule");
+            return true;
+        }
+
+        public bool CronSchedule(AAEmu.Game.Models.Tasks.Task task, string cronExpression,
+            TimeSpan? startDelay = null, int count = -1) => false;
+    }
+
