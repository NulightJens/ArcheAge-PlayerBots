+    /// <summary>
+    /// Compensates a creation that was persisted but never returned as admitted.
+    /// The retained row is soft-tombstoned for auditability; no public deletion
+    /// command is exposed and an arbitrary character cannot enter this path.
+    /// </summary>
+    public bool RollbackServerOwnedBot(uint serverOwnedAccountId, uint characterId)
+    {
+        if (serverOwnedAccountId == 0 || characterId == 0)
+            return false;
+
+        lock (_serverOwnedCreationGate)
+        {
+            if (!_rollbackEligibleServerOwnedBots.TryGetValue(characterId, out var expectedAccountId) ||
+                expectedAccountId != serverOwnedAccountId)
+            {
+                return false;
+            }
+
+            try
+            {
+                using var connection = MySQL.CreateConnection();
+                using var command = connection.CreateCommand();
+                command.CommandText =
+                    "UPDATE characters SET deleted = 1, delete_request_time = @deleted_at, " +
+                    "delete_time = @delete_time, name = @tombstone_name " +
+                    "WHERE id = @id AND account_id = @account_id AND deleted = 0";
+                command.Parameters.AddWithValue("@deleted_at", DateTime.UtcNow);
+                command.Parameters.AddWithValue("@delete_time", DateTime.MinValue);
+                command.Parameters.AddWithValue("@tombstone_name", $"!bot_rollback_{characterId}");
+                command.Parameters.AddWithValue("@id", characterId);
+                command.Parameters.AddWithValue("@account_id", serverOwnedAccountId);
+                command.Prepare();
+                if (command.ExecuteNonQuery() != 1)
+                    return false;
+
+                _rollbackEligibleServerOwnedBots.Remove(characterId);
+                nameManager.RemoveCharacterId(characterId);
+                Logger.Warn(
+                    $"Soft-tombstoned unadmitted server-owned bot {characterId} on account {serverOwnedAccountId}");
+                return true;
+            }
+            catch (Exception exception)
+            {
+                Logger.Error(exception,
+                    $"Unable to compensate server-owned bot creation {characterId}");
+                return false;
+            }
+        }
+    }
