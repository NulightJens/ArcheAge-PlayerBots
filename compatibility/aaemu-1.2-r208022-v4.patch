+    private bool TryResolveBotPlacement(
+        BotIdentityPlacement requested,
+        out WorldSpawnPosition placement)
+    {
+        placement = null;
+        if (requested.Mode == BotIdentityPlacementMode.RaceSpawn)
+            return true;
+        if (requested.Mode != BotIdentityPlacementMode.Here ||
+            requested.InstanceId != WorldManager.DefaultInstanceId)
+        {
+            return false;
+        }
+
+        var world = worldManager.GetWorld(requested.InstanceId);
+        var zoneKeys = worldManager.GetZoneKeysByWorldId(requested.WorldId);
+        if (world?.Template?.Id != requested.WorldId ||
+            zoneKeys == null || !zoneKeys.Contains(requested.ZoneId))
+        {
+            return false;
+        }
+
+        placement = new WorldSpawnPosition
+        {
+            WorldId = requested.WorldId,
+            ZoneId = requested.ZoneId,
+            X = requested.X,
+            Y = requested.Y,
+            Z = requested.Z,
+            Roll = requested.Roll,
+            Pitch = requested.Pitch,
+            Yaw = requested.Yaw
+        };
+        return true;
+    }
