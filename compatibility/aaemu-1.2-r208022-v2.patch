@@ -17,14 +19,21 @@ public class TickManager : Singleton<TickManager>, ITickManager
     {
         var sw = new Stopwatch();
         sw.Start();
+        var previousTickStarted = 0L;
         while (DoTickLoop)
         {
+            var tickStarted = Stopwatch.GetTimestamp();
+            var intervalMs = previousTickStarted == 0
+                ? TickSleepMilliseconds
+                : Stopwatch.GetElapsedTime(previousTickStarted, tickStarted).TotalMilliseconds;
+            previousTickStarted = tickStarted;
             var before = sw.Elapsed;
             OnTick.Invoke();
             var time = sw.Elapsed - before;
+            Metrics.RecordTick(time.TotalMilliseconds, intervalMs);
             if (time > TimeSpan.FromMilliseconds(100))
                 Logger.Warn("Tick took {0}ms to finish", time.TotalMilliseconds);
-            Thread.Sleep(20);
+            Thread.Sleep(TickSleepMilliseconds);
         }
         sw.Stop();
     }
