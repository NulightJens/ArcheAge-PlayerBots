+    /// <summary>
+    /// Reads an existing game account without creating a row as a side effect.
+    /// Server-owned identities must be bound to an account provisioned by an
+    /// operator, never to an implicit account created by character creation.
+    /// </summary>
+    public bool TryGetExistingAccountDetails(uint accountId, out AccountDetails accountDetails)
+    {
+        accountDetails = new AccountDetails();
+        if (accountId == 0 || accountId > int.MaxValue)
+            return false;
+
+        try
+        {
+            using var connection = MySQL.CreateConnection();
+            using var command = connection.CreateCommand();
+            command.CommandText = "SELECT * FROM accounts WHERE account_id = @acc_id";
+            command.Parameters.AddWithValue("@acc_id", accountId);
+            command.Prepare();
+            using var reader = command.ExecuteReader();
+            if (!reader.Read())
+                return false;
+
+            accountDetails.AccountId = reader.GetInt32("account_id");
+            accountDetails.AccessLevel = reader.GetInt32("access_level");
+            accountDetails.Labor = reader.GetInt16("labor");
+            accountDetails.Credits = reader.GetInt32("credits");
+            accountDetails.Loyalty = reader.GetInt32("loyalty");
+            accountDetails.LastUpdated = reader.GetDateTime("last_updated");
+            accountDetails.LastLogin = reader.GetDateTime("last_login");
+            accountDetails.LastLaborTick = reader.GetDateTime("last_labor_tick");
+            accountDetails.LastCreditsTick = reader.GetDateTime("last_credits_tick");
+            accountDetails.LastLoyaltyTick = reader.GetDateTime("last_loyalty_tick");
+            return accountDetails.AccountId == (int)accountId;
+        }
+        catch (Exception exception)
+        {
+            Logger.Error(exception, $"Failed to read existing account {accountId}");
+            accountDetails = new AccountDetails();
+            return false;
+        }
+    }
