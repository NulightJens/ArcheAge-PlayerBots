+    /// <summary>
+    /// Creates a native persistent character without a GameConnection, character
+    /// selection slot, or client packet. All validation and allocation remain
+    /// owned by the server; PlayerBots supplies only the bounded creation request.
+    /// </summary>
+    public BotIdentityAuthorityResult CreateServerOwnedBot(BotIdentityAuthorityRequest request)
+    {
+        if (request == null || request.ServerOwnedAccountId == 0 ||
+            request.ServerOwnedAccountId > int.MaxValue)
+        {
+            return BotIdentityAuthorityResult.Failure(
+                BotIdentityAuthorityStatus.AccountUnavailable,
+                "server_owned_account_invalid");
+        }
+        if (string.IsNullOrWhiteSpace(request.Name))
+        {
+            return BotIdentityAuthorityResult.Failure(
+                BotIdentityAuthorityStatus.InvalidName,
+                "name_missing");
+        }
+        if (accountManager.Contains(request.ServerOwnedAccountId))
+        {
+            return BotIdentityAuthorityResult.Failure(
+                BotIdentityAuthorityStatus.AccountOnline,
+                "server_owned_account_online");
+        }
+        if (!accountManager.TryGetExistingAccountDetails(request.ServerOwnedAccountId, out var accountDetails))
+        {
+            return BotIdentityAuthorityResult.Failure(
+                BotIdentityAuthorityStatus.AccountUnavailable,
+                "server_owned_account_missing");
+        }
+        if (request.Level == 0 || MaxPlayerLevel == 0 || request.Level > MaxPlayerLevel)
+        {
+            return BotIdentityAuthorityResult.Failure(
+                BotIdentityAuthorityStatus.Failed,
+                "level_out_of_range");
+        }
+        if (!Enum.IsDefined(request.Race) || request.Race == Race.None ||
+            !Enum.IsDefined(request.Gender))
+        {
+            return BotIdentityAuthorityResult.Failure(
+                BotIdentityAuthorityStatus.TemplateUnavailable,
+                "race_or_gender_unsupported");
+        }
+        if (!IsPlayableAbility(request.Ability1) ||
+            !IsOptionalPlayableAbility(request.Ability2) ||
+            !IsOptionalPlayableAbility(request.Ability3) ||
+            new[] { request.Ability1, request.Ability2, request.Ability3 }
+                .Where(IsPlayableAbility)
+                .Distinct()
+                .Count() != new[] { request.Ability1, request.Ability2, request.Ability3 }
+                .Count(IsPlayableAbility))
+        {
+            return BotIdentityAuthorityResult.Failure(
+                BotIdentityAuthorityStatus.TemplateUnavailable,
+                "ability_plan_invalid");
+        }
+        if (!request.Placement.IsValid || !TryResolveBotPlacement(request.Placement, out var placement))
+        {
+            return BotIdentityAuthorityResult.Failure(
+                BotIdentityAuthorityStatus.PlacementUnavailable,
+                "placement_unavailable");
+        }
+
+        var templateKey = (byte)(16 * (byte)request.Gender + (byte)request.Race);
+        if (!_templates.TryGetValue(templateKey, out var template) ||
+            !_abilityItems.TryGetValue((byte)request.Ability1, out var startingItems) ||
+            startingItems?.Items == null)
+        {
+            return BotIdentityAuthorityResult.Failure(
+                BotIdentityAuthorityStatus.TemplateUnavailable,
+                "character_template_unavailable");
+        }
+
+        lock (_serverOwnedCreationGate)
+        {
+            if (accountManager.Contains(request.ServerOwnedAccountId))
+            {
+                return BotIdentityAuthorityResult.Failure(
+                    BotIdentityAuthorityStatus.AccountOnline,
+                    "server_owned_account_online");
+            }
+
+            var name = request.Name.NormalizeName();
+            var nameValidation = nameManager.ValidateCharacterName(name);
+            if (nameValidation != CharacterCreateError.Ok)
+            {
+                var status = nameValidation is CharacterCreateError.NameAlreadyExists or CharacterCreateError.Failed
+                    ? BotIdentityAuthorityStatus.NameUnavailable
+                    : BotIdentityAuthorityStatus.InvalidName;
+                return BotIdentityAuthorityResult.Failure(status, $"name_{nameValidation.ToString().ToLowerInvariant()}");
+            }
+
+            uint characterId;
+            try
+            {
+                characterId = characterIdManager.GetNextId();
+            }
+            catch (Exception exception)
+            {
+                Logger.Error(exception, "Unable to allocate a server-owned bot character id");
+                return BotIdentityAuthorityResult.Failure(
+                    BotIdentityAuthorityStatus.IdUnavailable,
+                    "character_id_unavailable");
+            }
+
+            Character character = null;
+            var nameRegistered = false;
+            try
+            {
+                nameManager.AddCharacter(characterId, name, request.ServerOwnedAccountId);
+                nameRegistered = true;
+                character = InitializeServerOwnedBot(
+                    characterId,
+                    request,
+                    name,
+                    accountDetails,
+                    template,
+                    startingItems,
+                    placement);
+
+                if (!character.SaveDirectlyToDatabase())
+                {
+                    RollbackUncommittedBot(characterId, nameRegistered);
+                    return BotIdentityAuthorityResult.Failure(
+                        BotIdentityAuthorityStatus.PersistenceFailed,
+                        "character_persistence_failed");
+                }
+
+                _rollbackEligibleServerOwnedBots[characterId] = request.ServerOwnedAccountId;
+                return BotIdentityAuthorityResult.Created(character);
+            }
+            catch (Exception exception)
+            {
+                Logger.Error(exception,
+                    $"Unable to initialize server-owned bot {name} ({characterId})");
+                RollbackUncommittedBot(characterId, nameRegistered);
+                return BotIdentityAuthorityResult.Failure(
+                    BotIdentityAuthorityStatus.Failed,
+                    $"character_initialization_failed_{exception.GetType().Name}");
+            }
+        }
+    }
